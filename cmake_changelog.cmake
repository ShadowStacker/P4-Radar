# Writes the top of CHANGELOG.md into a C++ source, for the "What's new"
# screen after an update. Included by main/CMakeLists.txt and sim/CMakeLists.txt.
#   plane_radar_changelog(<CHANGELOG.md> <output .cpp>)
function(plane_radar_changelog changelog out)
  if(EXISTS "${changelog}")
    file(READ "${changelog}" text)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${changelog}")
  else()
    set(text "")
  endif()
  set(src "// Generated from CHANGELOG.md by cmake_changelog.cmake; do not edit.\n")
  string(APPEND src "namespace app {\nextern const char kChangelogMarkdown[];\nconst char kChangelogMarkdown[] = R\"CHANGELOG(${text})CHANGELOG\";\n}  // namespace app\n")
  if(EXISTS "${out}")
    file(READ "${out}" old)
  else()
    set(old "")
  endif()
  if(NOT old STREQUAL src)
    file(WRITE "${out}" "${src}")
  endif()
endfunction()
