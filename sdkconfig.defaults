# ---- Target / flash --------------------------------------------------------
CONFIG_IDF_TARGET="esp32p4"
# Chip revision v3.x (current boards). For older v1.x chips add the
# sdkconfig.defaults.p4rev1 overlay; one image can't support both.
CONFIG_ESP32P4_REV_MIN_300=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Updates over Wi-Fi: a new version that doesn't start properly (crashes or
# resets before it confirms itself) goes back to the previous one.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="1.18.3"

# ---- CPU / memory -------------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
# The UI renders on core 1; keep the network stack's tasks on core 0 so
# downloads don't take turns with it (both run above the UI's priority).
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_FREERTOS_TIMER_TASK_AFFINITY_CPU0=y
# Per-task CPU time for the "cpu:" line in the serial log.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Keep internal RAM free for FreeRTOS objects, Wi-Fi/SDIO and display DMA even
# if many small allocations land there.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# ---- TLS: verify the ADS-B APIs with the bundled CA store --------------------
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# ---- Wi-Fi via ESP32-C6 co-processor (ESP-Hosted over SDIO) -------------------
# Default P4 SDIO pins match this board: CLK 18, CMD 19, D0-D3 14-17, C6 reset 54.
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_HOST_SDIO_BUS_WIDTH_4=y
CONFIG_LWIP_LOCAL_HOSTNAME="plane-radar"
# Room for the phone page's connections next to the feed, map and lookup
# downloads (the default 10 sockets would run out); browsers send long headers.
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
# If the C6 link fails, keep the radar running (offline) instead of rebooting
# the whole board in a loop.
# CONFIG_ESP_HOSTED_HOST_TRANSPORT_RESTART_ON_FAILURE is not set
# CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE is not set

# ---- Board (Waveshare BSP) ---------------------------------------------------
# 3.4" 800x800 by default; see sdkconfig.defaults.4inch for the 720x720 board.
CONFIG_BSP_LCD_TYPE_800_800_3_4_INCH=y
CONFIG_BSP_LCD_COLOR_FORMAT_RGB565=y
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=3
CONFIG_BSP_I2C_FAST_MODE=y

# ---- Display ------------------------------------------------------------------
# The panel is refreshed by a DMA transfer that an interrupt restarts after
# every frame. Without this, that interrupt waits while the flash is written
# (settings saves, firmware updates), the panel runs out of pixels and flashes
# cyan ("underrun"). The adapter's callbacks are already in IRAM.
CONFIG_LCD_DSI_ISR_IRAM_SAFE=y

# ---- LVGL 9 ---------------------------------------------------------------------
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_DPI_DEF=200
# Keep LVGL out of IRAM: placing it there overflows the shared DIRAM region
# at link time once ESP-Hosted, TLS and the BSP are in the image.
# CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM is not set
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_44=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_22=y
# QR code for the phone settings page; screen snapshots for screenshots.
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y

# ---- microSD card (map tile cache) -------------------------------------------
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
